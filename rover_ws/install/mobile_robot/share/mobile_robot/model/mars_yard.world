<?xml version="1.0" ?>
<!--
  ERC 2026 Mars Yard Simulation World
  =====================================
  Based on ERC rulebook specifications:
  - Sandy, non-cohesive soil with reddish hematite color
  - Slopes at various angles (up to ~20 degrees)
  - Boulders and rocks of different sizes
  - A shallow crater
  - ArUco marker stands (Navigation/Maintenance tasks)
  - ~20x20m playable area

  ArUco markers: the flat planes on the stands have Gazebo
  visual materials mapped to them. In your real pipeline, replace
  the material with an actual ArUco texture or use a camera +
  aruco_ros to detect them.
-->
<sdf version="1.6">
  <world name="mars_yard">

    <!-- ===================== LIGHTING ===================== -->
    <!-- Mars-like directional light, low angle sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0.3 0.5</pose>
      <diffuse>0.9 0.7 0.5 1</diffuse>
      <specular>0.3 0.2 0.1 1</specular>
      <direction>-0.5 0.3 -0.8</direction>
    </light>

    <!-- Ambient fill to avoid pitch-black shadows -->
    <scene>
      <ambient>0.3 0.2 0.15 1</ambient>
      <background>0.55 0.35 0.2 1</background>
      <sky>
        <clouds>
          <speed>0</speed>
        </clouds>
      </sky>
    </scene>

    <!-- ===================== PHYSICS ===================== -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ===================== BASE GROUND PLANE (reddish Mars soil) ===================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- Sandy, loose soil = lower friction than concrete -->
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <soft_cfm>0.001</soft_cfm>
                <soft_erp>0.15</soft_erp>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.3 0.15 1</ambient>
            <diffuse>0.7 0.35 0.18 1</diffuse>
            <specular>0.1 0.05 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== SLOPE 1: Gentle ramp (~10 deg) North side ===================== -->
    <model name="slope_north">
      <static>true</static>
      <pose>6 0 0.35 0 -0.175 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8 6 0.7</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>0.55</mu><mu2>0.55</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 6 0.7</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.28 0.12 1</ambient>
            <diffuse>0.65 0.32 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== SLOPE 2: Steeper ramp (~18 deg) South-West ===================== -->
    <model name="slope_southwest">
      <static>true</static>
      <pose>-5 -5 0.55 0.08 -0.31 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6 4 0.9</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 4 0.9</size></box>
          </geometry>
          <material>
            <ambient>0.52 0.26 0.11 1</ambient>
            <diffuse>0.62 0.30 0.14 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== SHALLOW CRATER ===================== -->
    <!-- Simulated as an inverted truncated cone (cylinder depression) -->
    <!-- In Gazebo classic we fake it with a sunken ring of blocks -->
    <model name="crater_rim_1">
      <static>true</static>
      <pose>-3 6 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>2.5</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>2.5</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.45 0.22 0.10 1</ambient><diffuse>0.55 0.27 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Inner crater floor (sunken) -->
    <model name="crater_floor">
      <static>true</static>
      <pose>-3 6 -0.22 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>1.6</radius><length>0.1</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>1.6</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.40 0.20 0.09 1</ambient><diffuse>0.50 0.25 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== BOULDERS ===================== -->
    <!-- Large boulder 1 -->
    <model name="boulder_large_1">
      <static>true</static>
      <pose>2 4 0.35 0.2 0.1 0.5</pose>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.35</radius></sphere></geometry></collision>
        <visual name="vis">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.4 0.22 0.12 1</ambient><diffuse>0.5 0.27 0.15 1</diffuse><specular>0.15 0.1 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Large boulder 2 -->
    <model name="boulder_large_2">
      <static>true</static>
      <pose>-7 2 0.3 0.1 0.3 1.0</pose>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.3</radius></sphere></geometry></collision>
        <visual name="vis">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material><ambient>0.38 0.20 0.11 1</ambient><diffuse>0.48 0.25 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Medium boulder cluster near slope -->
    <model name="boulder_med_1">
      <static>true</static>
      <pose>5 3 0.18 0.3 0 0.7</pose>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision>
        <visual name="vis">
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.42 0.23 0.12 1</ambient><diffuse>0.52 0.28 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boulder_med_2">
      <static>true</static>
      <pose>5.6 2.5 0.15 0 0.2 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.15</radius></sphere></geometry></collision>
        <visual name="vis">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.42 0.23 0.12 1</ambient><diffuse>0.52 0.28 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boulder_med_3">
      <static>true</static>
      <pose>-1 -3 0.2 0.1 0.1 1.2</pose>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
        <visual name="vis">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material><ambient>0.40 0.21 0.11 1</ambient><diffuse>0.50 0.26 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small rocks scattered -->
    <model name="rock_small_1"><static>true</static><pose>3 -2 0.07 0.2 0.1 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.14 0.1 0.08</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.14 0.1 0.08</size></box></geometry><material><ambient>0.44 0.24 0.13 1</ambient></material></visual></link></model>

    <model name="rock_small_2"><static>true</static><pose>-4 1 0.06 0 0.3 1</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.12 0.09 0.06</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.12 0.09 0.06</size></box></geometry><material><ambient>0.44 0.24 0.13 1</ambient></material></visual></link></model>

    <model name="rock_small_3"><static>true</static><pose>0 5 0.06 0.1 0 0.6</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.11 0.08 0.06</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.11 0.08 0.06</size></box></geometry><material><ambient>0.44 0.24 0.13 1</ambient></material></visual></link></model>

    <model name="rock_small_4"><static>true</static><pose>7 -1 0.05 0 0.1 0.9</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.1 0.08 0.05</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 0.08 0.05</size></box></geometry><material><ambient>0.44 0.24 0.13 1</ambient></material></visual></link></model>

    <model name="rock_small_5"><static>true</static><pose>-6 -4 0.07 0.15 0 0.4</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.13 0.09 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.13 0.09 0.07</size></box></geometry><material><ambient>0.44 0.24 0.13 1</ambient></material></visual></link></model>

    <!-- ===================== ARUCO MARKER STANDS ===================== -->
    <!--
      Each stand = a vertical pole + a flat board face.
      The board face simulates where an ArUco marker texture would go.
      In production: replace <material> on the board with a
      custom texture URI pointing to your ArUco PNG image.

      IDs used here:  Marker_0 through Marker_4
      These match the ar_track_alvar / aruco_ros default dict.
    -->

    <!-- Marker Stand 0 - near start (0,0) for reference -->
    <model name="aruco_stand_0">
      <static>true</static>
      <pose>1.5 0 0 0 0 0</pose>
      <link name="pole">
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="board">
        <!-- Board face at ~0.8m height, facing +X direction -->
        <pose>0.05 0 0.85 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.02 0.3 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.02 0.3 0.3</size></box></geometry>
          <!-- Replace this with your ArUco marker texture -->
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <!-- To use a real texture: -->
            <!-- <script><uri>file://textures/aruco_0.png</uri></script> -->
          </material>
        </visual>
      </link>
      <joint name="pole_board" type="fixed">
        <parent>pole</parent><child>board</child>
      </joint>
    </model>

    <!-- Marker Stand 1 - checkpoint A area -->
    <model name="aruco_stand_1">
      <static>true</static>
      <pose>4 3 0 0 0 1.57</pose>
      <link name="pole">
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="board">
        <pose>0.05 0 0.85 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.02 0.3 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.02 0.3 0.3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <joint name="pole_board" type="fixed"><parent>pole</parent><child>board</child></joint>
    </model>

    <!-- Marker Stand 2 - checkpoint B area -->
    <model name="aruco_stand_2">
      <static>true</static>
      <pose>-2 7 0 0 0 -0.785</pose>
      <link name="pole">
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="board">
        <pose>0.05 0 0.85 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.02 0.3 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.02 0.3 0.3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <joint name="pole_board" type="fixed"><parent>pole</parent><child>board</child></joint>
    </model>

    <!-- Marker Stand 3 - checkpoint C area -->
    <model name="aruco_stand_3">
      <static>true</static>
      <pose>-6 0 0 0 0 0</pose>
      <link name="pole">
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="board">
        <pose>0.05 0 0.85 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.02 0.3 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.02 0.3 0.3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <joint name="pole_board" type="fixed"><parent>pole</parent><child>board</child></joint>
    </model>

    <!-- Marker Stand 4 - checkpoint D / maintenance panel area -->
    <model name="aruco_stand_4">
      <static>true</static>
      <pose>2 -6 0 0 0 3.14</pose>
      <link name="pole">
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="board">
        <pose>0.05 0 0.85 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.02 0.3 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.02 0.3 0.3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <joint name="pole_board" type="fixed"><parent>pole</parent><child>board</child></joint>
    </model>

    <!-- ===================== BOUNDARY WALLS (invisible collision, keeps rover in) ===================== -->
    <model name="wall_north"><static>true</static><pose>0 11 0.5 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>22 0.2 1.0</size></box></geometry></collision></link></model>
    <model name="wall_south"><static>true</static><pose>0 -11 0.5 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>22 0.2 1.0</size></box></geometry></collision></link></model>
    <model name="wall_east"><static>true</static><pose>11 0 0.5 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.2 22 1.0</size></box></geometry></collision></link></model>
    <model name="wall_west"><static>true</static><pose>-11 0 0.5 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.2 22 1.0</size></box></geometry></collision></link></model>

  </world>
</sdf>
